{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "app": {
            "root": ".",
            "framework": "fastapi"
        },
        "backend": {
            "root": "backend",
            "framework": "fastapi"
        },
        "frontend": {
            "root": "frontend",
            "framework": "nextjs"
        },
        "honeypot": {
            "root": "honeypot",
            "runtime": "python"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "app"
            }
        }
    ]
}